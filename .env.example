DATABASE_URL=postgresql://hackrails:hackrails@localhost:5432/hackrails
DEMO_MODE=true
USAGE_RESERVATION_TIMEOUT_MS=300000
DEMO_ADMIN_KEY=replace-with-a-local-demo-admin-key
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PREMIUM_SERVICE_URL=http://localhost:4002
# Canonical x402 v2 Hedera configuration. The provider holds no private key.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
# Hedera Testnet USDC (6 decimals).
HEDERA_USDC_TOKEN_ID=0.0.429274
# Configure all three values and set DEMO_MODE=false. The API's organizer key is the x402 buyer/sponsor.
# HEDERA_ACCOUNT_ID=0.0.x
# HEDERA_PRIVATE_KEY=...
# HEDERA_RECIPIENT_ACCOUNT_ID=0.0.y
